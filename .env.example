# Copy to .env for local development.
# Local: `npm run db:local` starts an embedded Postgres on port 54329.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/wms"

# Pool tuning (optional; sensible defaults are applied in src/server/db/client.ts)
DB_POOL_SIZE=10

# Used only by the seed script. Every seeded user gets this password.
SEED_PASSWORD="ChangeMe!2026"

# Node environment. Railway sets PORT automatically.
NODE_ENV=development
